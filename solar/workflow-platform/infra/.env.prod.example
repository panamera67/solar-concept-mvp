# ==============================
# Solar Concept - Production env
# ==============================

# Application
NODE_ENV=production
FRONTEND_URL=https://app.solar-concept.com

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=solar_user
DB_PASSWORD=your_db_password
DB_NAME=solar_prod

# JWT
JWT_SECRET=replace_with_secure_random_secret

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional Vault flag
USE_VAULT=false
