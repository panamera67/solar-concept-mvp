# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/workflows

# Worker settings
WORKER_POLL_INTERVAL_MS=3000
WORKER_MAX_RETRIES=3

# App settings
PORT=3000

# Optional: SMTP or external API keys used by handlers
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=youruser
SMTP_PASS=yourpass

# Example secret to sign intents (optional)
WORKFLOW_SIGNING_SECRET=change_me
